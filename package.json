{
  "name": "rego-syntax-support",
  "displayName": "Rego Syntax Support",
  "description": "Rego (Open Policy Agent) syntax highlighting and snippets, including Rego embedded in Gatekeeper/Kubernetes YAML and Markdown",
  "version": "0.2.1",
  "publisher": "AdamaKomi",
  "author": {
    "name": "Adama Komi"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "rego",
    "opa",
    "open policy agent",
    "policy as code",
    "gatekeeper",
    "kubernetes",
    "authorization",
    "rbac",
    "abac",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adamaKomi/rego-syntax-support.git"
  },
  "bugs": {
    "url": "https://github.com/adamaKomi/rego-syntax-support/issues"
  },
  "homepage": "https://github.com/adamaKomi/rego-syntax-support#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "contributes": {
    "languages": [
      {
        "id": "rego",
        "aliases": [
          "Rego",
          "rego",
          "OPA Rego"
        ],
        "extensions": [
          ".rego"
        ],
        "configuration": "./languages/rego-language-configuration.json",
        "icon": {
          "light": "./resources/rego-icon-light.svg",
          "dark": "./resources/rego-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rego",
        "scopeName": "source.rego",
        "path": "./syntaxes/rego.tmLanguage.json"
      },
      {
        "scopeName": "rego-syntax-support.injection.yaml",
        "path": "./syntaxes/rego.injection.yaml.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rego": "rego"
        }
      },
      {
        "scopeName": "rego-syntax-support.injection.yaml.line-start",
        "path": "./syntaxes/rego.injection.yaml.line-start.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rego": "rego"
        }
      },
      {
        "scopeName": "rego-syntax-support.injection.markdown",
        "path": "./syntaxes/rego.injection.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rego": "rego"
        }
      }
    ],
    "snippets": [
      {
        "language": "rego",
        "path": "./snippets/rego.snippets.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:grammar",
    "test:grammar": "npm run test:grammar:rego && npm run test:grammar:embedded && npm run test:grammar:embedded:legacy",
    "package": "vsce package",
    "publish": "vsce publish",
    "clean": "rimraf out",
    "prepare": "npm run compile",
    "build:grammars": "node scripts/build-grammars.js",
    "check:grammars": "node scripts/build-grammars.js --check",
    "update:builtins": "node scripts/update-builtins.js",
    "test:grammar:rego": "vscode-tmgrammar-test -c \"test/grammar/*.test.rego\"",
    "test:grammar:embedded": "vscode-tmgrammar-test -c -g test/vendor/vscode-grammars/yaml.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.0.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.1.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.2.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.3.tmLanguage.json -g test/vendor/vscode-grammars/yaml-embedded.tmLanguage.json -g test/vendor/vscode-grammars/markdown.tmLanguage.json \"test/embedded/*.test.yaml\" \"test/embedded/*.test.md\"",
    "test:unit": "node ./out/test/unit/index.js",
    "test:integration": "node ./out/test/runTest.js",
    "test:grammar:embedded:legacy": "vscode-tmgrammar-test -c -g test/vendor/vscode-1.85-grammars/yaml.tmLanguage.json \"test/embedded/*.test.yaml\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "sharp": "^0.34.5",
    "typescript": "^5.3.2",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "overrides": {
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "1.7.0"
  }
}
