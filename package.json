{
  "name": "rego-syntax-support",
  "displayName": "Rego Syntax Support",
  "description": "Open Policy Agent (OPA) Rego highlighting, snippets and Gatekeeper template checks, including Rego embedded in Kubernetes YAML and Markdown",
  "version": "0.2.1",
  "publisher": "AdamaKomi",
  "author": {
    "name": "Adama Komi"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "rego",
    "opa",
    "open policy agent",
    "policy as code",
    "gatekeeper",
    "kubernetes",
    "authorization",
    "rbac",
    "abac",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adamaKomi/rego-syntax-support.git"
  },
  "bugs": {
    "url": "https://github.com/adamaKomi/rego-syntax-support/issues"
  },
  "homepage": "https://github.com/adamaKomi/rego-syntax-support#readme",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "browser": "./out/web.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:rego"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Checking the Rego of Gatekeeper templates and mutation testing run binaries (opa, regodrill), so they are off in Restricted Mode. Highlighting and snippets work.",
      "restrictedConfigurations": [
        "regoSyntaxSupport.opa.path",
        "regoSyntaxSupport.regodrill.path",
        "regoSyntaxSupport.regodrill.args"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "regoSyntaxSupport.checkEmbeddedRego",
        "title": "Check Rego in Gatekeeper Templates",
        "category": "Rego"
      },
      {
        "command": "regoSyntaxSupport.runMutationTesting",
        "title": "Run Mutation Testing",
        "category": "Rego"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "regoSyntaxSupport.checkEmbeddedRego",
          "when": "editorLangId == yaml && !isWeb"
        },
        {
          "command": "regoSyntaxSupport.runMutationTesting",
          "when": "!isWeb"
        }
      ]
    },
    "configuration": {
      "title": "Rego Syntax Support",
      "properties": {
        "regoSyntaxSupport.embeddedRego.check": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check the Rego of OPA Gatekeeper `ConstraintTemplate` files with `opa check` when they are opened or saved, and show the errors on the YAML lines. Rego v0 or v1 is chosen as Gatekeeper does (`source.version`)."
        },
        "regoSyntaxSupport.opa.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `opa` binary. Empty: the official OPA extension's `opa.dependency_paths.opa` if set, else `opa` on the `PATH`. Only the user value is used in Restricted Mode."
        },
        "regoSyntaxSupport.regodrill.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the [regodrill](https://github.com/adamaKomi/regodrill) binary, which runs mutation testing. Empty: `regodrill` on the `PATH`. Only the user value is used in Restricted Mode."
        },
        "regoSyntaxSupport.regodrill.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `regodrill run`, before the path, for example `[\"--v0-compatible\"]` or `[\"--operators=COMP_BOUNDARY,EXPR_REMOVE\"]`. Settings in `.regodrill.yaml` apply too. Only the user value is used in Restricted Mode."
        },
        "regoSyntaxSupport.regodrill.runOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run mutation testing again when a Rego file is saved (on the last target, or the workspace folder)."
        }
      }
    },
    "languages": [
      {
        "id": "rego",
        "aliases": [
          "Rego",
          "rego",
          "OPA Rego"
        ],
        "extensions": [
          ".rego"
        ],
        "configuration": "./languages/rego-language-configuration.json",
        "icon": {
          "light": "./resources/rego-icon-light.svg",
          "dark": "./resources/rego-icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "rego",
        "scopeName": "source.rego",
        "path": "./syntaxes/rego.tmLanguage.json"
      },
      {
        "scopeName": "rego-syntax-support.injection.yaml",
        "path": "./syntaxes/rego.injection.yaml.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rego": "rego"
        }
      },
      {
        "scopeName": "rego-syntax-support.injection.yaml.line-start",
        "path": "./syntaxes/rego.injection.yaml.line-start.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rego": "rego"
        }
      },
      {
        "scopeName": "rego-syntax-support.injection.markdown",
        "path": "./syntaxes/rego.injection.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rego": "rego"
        }
      }
    ],
    "snippets": [
      {
        "language": "rego",
        "path": "./snippets/rego.snippets.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:grammar",
    "test:grammar": "npm run test:grammar:rego && npm run test:grammar:embedded && npm run test:grammar:embedded:legacy",
    "package": "vsce package",
    "publish": "vsce publish",
    "clean": "rimraf out",
    "prepare": "npm run compile",
    "build:grammars": "node scripts/build-grammars.js",
    "check:grammars": "node scripts/build-grammars.js --check",
    "update:builtins": "node scripts/update-builtins.js",
    "test:grammar:rego": "vscode-tmgrammar-test -c \"test/grammar/*.test.rego\"",
    "test:grammar:embedded": "vscode-tmgrammar-test -c -g test/vendor/vscode-grammars/yaml.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.0.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.1.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.2.tmLanguage.json -g test/vendor/vscode-grammars/yaml-1.3.tmLanguage.json -g test/vendor/vscode-grammars/yaml-embedded.tmLanguage.json -g test/vendor/vscode-grammars/markdown.tmLanguage.json \"test/embedded/*.test.yaml\" \"test/embedded/*.test.md\"",
    "test:unit": "node ./out/test/unit/index.js",
    "test:integration": "node ./out/test/runTest.js",
    "test:grammar:embedded:legacy": "vscode-tmgrammar-test -c -g test/vendor/vscode-1.85-grammars/yaml.tmLanguage.json \"test/embedded/*.test.yaml\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.71.2",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "overrides": {
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "1.7.0",
    "serialize-javascript": "7.1.2",
    "diff": "8.0.4"
  }
}
