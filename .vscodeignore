# Source files (not needed in published extension)
.vscode/**
src/**
test/**
docs/**
scripts/**

# Config files
eslint.config.mjs
.prettierrc
.gitignore
.editorconfig
tsconfig.json
*.map

# Build/Dev files
node_modules/**
# Compiled code: keep the extension (out/*.js, out/embedded/*.js), not the tests and build artifacts.
out/test/**
out/snippets-check/**
out/**/*.map
out/**/*.d.ts
coverage/**
.nyc_output/**

# Git
.git/**
.github/**

# Package files
*.vsix

# Misc
**/*.ts
**/.gitkeep

# Resources not needed
resources/icon.png.placeholder
resources/ICON_README.md
